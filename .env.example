# ==============================================================================
# Entorno y Configuración General (Variables de Ejemplo no sensibles)
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==============================================================================
# Backend (FastAPI)
# ==============================================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# Base de Datos Relacional (SQLite) - Administrada por Servidor MCP
# ==============================================================================
DATABASE_URL=sqlite:///backend/data/mira_cu3.db

# ==============================================================================
# Componente RAG y Base de Datos Vectorial
# ==============================================================================
CHROMA_PERSIST_DIRECTORY=backend/data/chroma_db
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MAX_SEQ_LENGTH=256
RAG_TOP_K=4
# Similitud coseno mínima. No separa preguntas sin respuesta (ver ADR-11): la abstención la decide el orquestador.
RAG_SCORE_THRESHOLD=0.35
# hibrido (denso + BM25 con RRF) | denso
RAG_MODO_BUSQUEDA=hibrido

# ==============================================================================
# Proveedor LLM (Google Gemini API)
# ==============================================================================
# Obtener en Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# Seguridad y Delegación MCP (AUD-03, PR-6, PR-7)
# ==============================================================================
# Clave HMAC para sesiones demo y tokens de confirmación efímeros (mínimo 16 caracteres; 32 en prod)
JWT_SECRET=mira_demo_secret_key_development_only_2026

# Secreto compartido independiente para delegación de identidad en invocaciones FastMCP (AUD-03, PR-7).
# OBLIGATORIO: debe configurarse con un secreto aleatorio independiente de JWT_SECRET, de al menos 32 bytes UTF-8.
# Generación recomendada en terminal: openssl rand -base64 32
MIRA_MCP_DELEGATION_SECRET=

# ==============================================================================
# Frontend (React + Vite)
# ==============================================================================
VITE_API_BASE_URL=http://localhost:8000/api
