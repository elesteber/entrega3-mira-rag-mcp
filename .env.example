# ==============================================================================
# MIRA CU-3 · Variables de Entorno de Ejemplo (Release v3.0)
# Copiar este archivo como .env en la raíz del repositorio: cp .env.example .env
# NUNCA guardar claves de API, tokens ni secretos reales en el repositorio.
# ==============================================================================

# Entorno y Logging
ENVIRONMENT=development
LOG_LEVEL=INFO

# Servidor FastAPI Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# Base de Datos Relacional (SQLite) y Vectorial (ChromaDB)
# NOTA: El backend utiliza SQLITE_DB_PATH y CHROMADB_PATH (no DATABASE_URL ni CHROMA_PERSIST_DIRECTORY).
# Para demostraciones en vivo se recomienda apuntar a una copia (mira_cu3_demo.db)
# preservando la base de datos original (mira_cu3.db) intacta.
# ==============================================================================
SQLITE_DB_PATH=backend/data/mira_cu3.db
CHROMADB_PATH=backend/data/chroma_db
CORPUS_DIR=archivos-base/Kit_Entrega_3_MIRA/CU-3_incorporacion_organizaciones/corpus
EXCEL_DATA_PATH=archivos-base/Kit_Entrega_3_MIRA/CU-3_incorporacion_organizaciones/datos/CU-3_datos.xlsx

# ==============================================================================
# Parámetros del Componente RAG
# ==============================================================================
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MAX_SEQ_LENGTH=256
RAG_TOP_K=4
# hibrido (denso + BM25 con Reciprocal Rank Fusion) | denso
RAG_MODO_BUSQUEDA=hibrido
RAG_SCORE_THRESHOLD=0.35

# ==============================================================================
# Proveedor LLM (Google Gemini API mediante SDK google-genai)
# Obtener una clave gratuita en Google AI Studio: https://aistudio.google.com/
# Modelo candidato configurable: gemini-3.5-flash-lite, gemini-3.8-flash, etc.
# ==============================================================================
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30.0

# ==============================================================================
# Seguridad y Delegación de Identidad MCP (AUD-03, PR-6, PR-7)
# OBLIGATORIO: Configurar dos secretos independientes de al menos 32 bytes UTF-8.
# Generación recomendada en terminal: openssl rand -base64 32
# ==============================================================================
# Secreto 1: Firma HMAC de sesiones demo y tokens de confirmación efímeros (5 min)
JWT_SECRET=mira_jwt_demo_secret_development_min_32_bytes_ok!

# Secreto 2: Delegación criptográfica de identidad hacia FastMCP stdio (AUD-03, PR-7).
# Debe ser INDEPENDIENTE y diferente de JWT_SECRET.
MIRA_MCP_DELEGATION_SECRET=mira_mcp_delegation_secret_independent_32_bytes_ok!

# ==============================================================================
# Variables de Configuración para el Frontend (React + Vite)
# ==============================================================================
# URL base del backend FastAPI (sin barra al final)
VITE_API_URL=http://localhost:8000

# false: conecta con el backend real FastAPI + FastMCP + SQLite + RAG
# true: utiliza datos simulados en memoria para desarrollo UI aislado
VITE_USE_MOCKS=false
