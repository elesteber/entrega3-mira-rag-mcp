# ==============================================================================
# MIRA CU-3 · Variables de Entorno Frontend (React + Vite)
# Copiar este archivo como .env dentro del directorio frontend/: cp .env.example .env
# ==============================================================================

# URL base del backend FastAPI (sin barra al final)
VITE_API_URL=http://localhost:8000

# Modo de operación del frontend:
# false: conecta con el backend real FastAPI + FastMCP + SQLite + RAG (Demostración oficial)
# true:  utiliza datos simulados locales en memoria para desarrollo o pruebas aisladas
VITE_USE_MOCKS=false
